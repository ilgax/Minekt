{
  "schemaVersion": 1,
  "id": "minekt",
  "version": "${version}",
  "name": "Minekt",
  "description": "Kotlin scripting for Minecraft. Drop .kts files into .minecraft/minekt and run them from chat, like \\\\coords for coords.kts. On servers, operators run scripts from the server's minekt folder with /mks.",
  "authors": ["ilgax"],
  "contact": {
    "sources": "https://github.com/ilgax/Minekt"
  },
  "license": "GPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.ilgax.minekt.MinektServer"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.ilgax.minekt.MinektClient"
      }
    ],
    "modmenu": ["dev.ilgax.minekt.ModMenuEntry"]
  },
  "mixins": ["minekt.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  },
  "suggests": {
    "baritone": "*",
    "modmenu": "*"
  }
}
